{
  "model_version": "3.4.0",
  "description": "Projection-first custom-league value model. Aggregated raw-stat projections are scored under league rules and converted to corrected value over baseline; market and live context remain conservative guardrails.",
  "weights": {
    "custom_projected_value": 0.60,
    "baseline_consensus": 0.30,
    "opportunity": 0.05,
    "team_offense": 0.02,
    "offensive_line_fit": 0.02,
    "strength_of_schedule": 0.01
  },
  "risk_penalty_cap": 8.0,
  "movement_anchor": {
    "strategy": "weighted_consensus_order",
    "aggregation": "equal_source_mean",
    "tie_breaker": "espn_source_rank",
    "rule": "Order the baseline by the simple mean of all available ranks from ESPN, FantasyPros, FFToday, RotoBaller, Fantasy Football Calculator, LineupBeat, and Pro Football Mania; use ESPN only as the deterministic tie-breaker and lineage reference."
  },
  "injury_adjustment": {
    "availability_penalty_per_game": 0.65,
    "downside_cap_bonus_per_game": 4.0,
    "maximum_downside_cap_bonus": 24,
    "unbounded_downside_minimum_games": 5.0,
    "unbounded_downside_cap_bonus": 300,
    "rule": "Confidence-weighted expected games missed reduce projected value and add residual risk. Only absences corroborated by at least two providers expand the downside movement cap; projected absences of at least five games may move to their score-supported rank. Promotion caps never expand."
  },
  "round_value_highlights": {
    "picks_per_round": 1,
    "minimum_unconstrained_value_spots": 1,
    "excluded_positions": ["K", "DST"],
    "rule": "Within each final-rank draft round, highlight the non-kicker/non-defense player with the largest positive gap between the blended-consensus movement anchor and the rank supported by the full adjusted model score. Break ties by actual upward movement, adjusted score, then final rank."
  },
  "score_difference_to_reorder": 2.0,
  "same_team_depth_chart_tiebreaker": {
    "positions": ["QB", "RB", "TE"],
    "minimum_score_advantage": 0.0,
    "rule": "When comparable teammates are inverted, promote the better depth-chart role when its adjusted score is no lower and both movement caps remain valid."
  },
  "consensus_anomaly_guardrail": {
    "minimum_sources": 5,
    "rank_band_tolerances": [
      {"minimum_rank": 1, "maximum_rank": 24, "spots": 8},
      {"minimum_rank": 25, "maximum_rank": 72, "spots": 12},
      {"minimum_rank": 73, "maximum_rank": 144, "spots": 20},
      {"minimum_rank": 145, "maximum_rank": 300, "spots": 32}
    ],
    "rule": "Flag any final rank outside the rank-band tolerance around the seven-source median. A downward exception is resolved only when corroborated injury evidence expands the downside movement allowance; all other exceptions fail validation."
  },
  "league_structure": {
    "starting_slots": {
      "QB": 1,
      "RB": 2,
      "WR": 2,
      "TE": 1,
      "K": 1,
      "DST": 1
    },
    "flex_slots": 1,
    "flex_positions": ["RB", "WR", "TE"],
    "onesie_baseline_fraction": 0.5,
    "assumption": "Roster settings were not present in the supplied league rules; use 1 QB, 2 RB, 2 WR, 1 TE, 1 flex, K, and DST until confirmed."
  },
  "offensive_line_position_multiplier": {
    "QB": 1.0,
    "RB": 1.0,
    "WR": 0.4,
    "TE": 0.5,
    "K": 0.0,
    "DST": 0.0
  },
  "movement_caps": [
    {"minimum_rank": 1, "maximum_rank": 24, "spots": 2},
    {"minimum_rank": 25, "maximum_rank": 72, "spots": 4},
    {"minimum_rank": 73, "maximum_rank": 144, "spots": 8},
    {"minimum_rank": 145, "maximum_rank": 300, "spots": 12}
  ],
  "source_registry": {
    "custom_projected_value": [
      {"name": "ESPN Mike Clay 2026 Projection Guide", "role": "complete current raw-stat projection feed", "url": "https://g.espncdn.com/s/ffldraftkit/26/NFLDK2026_CS_ClayProjections2026.pdf"},
      {"name": "FFToday 2026 player projections", "role": "complete current raw-stat projection feed", "url": "https://www.fftoday.com/rankings/playerproj.php"},
      {"name": "Fantasy Football Analytics 2014-2025 accuracy study", "role": "historical MAE and aggregation validation", "url": "https://fantasyfootballanalytics.net/which-projections-are-most-accurate"},
      {"name": "RotoAlpha 2019-2024 oracle baseline backtest", "role": "median-starter QB and TE baseline validation", "url": "https://rotoalpha.com/nfl/articles/fantasy-football-when-to-draft-qb-and-te"}
    ],
    "baseline_consensus": [
      {"name": "ESPN 2026 PPR Top 300", "role": "projection baseline", "url": "https://g.espncdn.com/s/ffldraftkit/26/NFL26_CS_PPR300.pdf?adddata=2026CS_PPR300"},
      {"name": "FantasyPros half-PPR ECR", "role": "multi-expert consensus", "url": "https://www.fantasypros.com/nfl/rankings/half-point-ppr-cheatsheets.php"},
      {"name": "FFToday half-PPR ADP", "role": "Underdog and Yahoo market price", "url": "https://www.fftoday.com/rankings/26-adp-half-ppr.html"},
      {"name": "RotoBaller half-PPR Top 300", "role": "independent accurate-ranker board", "url": "https://www.rotoballer.com/fantasy-football-draft-rankings-august-updates-2026/1905031"},
      {"name": "Fantasy Football Calculator half-PPR", "role": "daily mock-draft market", "url": "https://fantasyfootballcalculator.com/rankings/half-ppr"},
      {"name": "LineupBeat half-PPR Top 200", "role": "projection and replacement-value board", "url": "https://lineupbeat.com/nfl/rankings/"},
      {"name": "Pro Football Mania half-PPR", "role": "editorial board with mock-ADP context", "url": "https://profootballmania.com/fantasy-football-rankings/"}
    ],
    "opportunity": [
      {"name": "Sleeper NFL player API", "role": "primary live roster depth", "url": "https://api.sleeper.app/v1/players/nfl?active=true"},
      {"name": "ESPN NFL depth charts", "role": "independent live order cross-check", "url": "https://www.espn.com/nfl/story/_/id/29098001/nfl-depth-charts-all-32-teams"}
    ],
    "team_offense": [
      {"name": "First Down Studio implied totals", "role": "primary market-implied scoring environment", "url": "https://www.firstdown.studio/implied-totals/season"},
      {"name": "Mike Clay NFL Projection Guide", "role": "independent football-stat projection cross-check", "url": "https://g.espncdn.com/s/ffldraftkit/26/NFLDK2026_CS_ClayProjections2026.pdf"}
    ],
    "offensive_line_fit": [
      {"name": "Sharp Football Analysis offensive line rankings", "role": "primary forward-looking staff rank", "url": "https://www.sharpfootballanalysis.com/analysis/best-nfl-offensive-line-rankings/"},
      {"name": "4for4 projected offensive line rankings", "role": "personnel and PFF-grade cross-check", "url": "https://www.4for4.com/2026/preseason/2026-projected-offensive-line-rankings"},
      {"name": "Mike Clay NFL Projection Guide", "role": "unit-grade and starter cross-check", "url": "https://g.espncdn.com/s/ffldraftkit/26/NFLDK2026_CS_ClayProjections2026.pdf"}
    ],
    "strength_of_schedule": [
      {"name": "DraftCall position-specific SOS", "role": "primary schedule rank", "url": "https://draftcall.io/strength-of-schedule/"},
      {"name": "FantasyPros position-specific SOS", "role": "method cross-check", "url": "https://www.fantasypros.com/nfl/strength-of-schedule.php"},
      {"name": "FFToolbox fantasy SOS", "role": "independent tier cross-check", "url": "https://www.fftoolbox.com/football/strength_of_schedule.cfm"}
    ],
    "injury_risk": [
      {"name": "Sleeper NFL player API", "role": "live designation feed", "url": "https://api.sleeper.app/v1/players/nfl?active=true"},
      {"name": "ESPN NFL injury report", "role": "live injury and return-date feed", "url": "https://www.espn.com/nfl/injuries"}
    ]
  }
}
